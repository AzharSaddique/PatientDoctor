<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MvvmWithFlow" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="searchViewStyle">@style/CustomSearchView</item>
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <!-- Customize your theme -->
        <item name="colorPrimary">@color/appcolor_1</item>
        <item name="colorPrimaryVariant">@color/appcolor_1</item>
        <item name="colorOnPrimary">@color/appcolor_1</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.MvvmWithFlow" parent="Base.Theme.MvvmWithFlow" />
    <style name="CustomSearchView" parent="Widget.AppCompat.SearchView">
        <item name="queryBackground">@android:color/transparent</item>
        <item name="queryHint">Search..</item>
    </style>
    <style name="CircleImageViewShape" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>

    </style>
    <style name="CircleImageViewShape1" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10%</item>

    </style>

